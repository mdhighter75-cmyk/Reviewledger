# Copy this file to .env.local for local development.
# In production, set these in your Vercel project settings (Settings → Environment Variables).
# Never commit your real keys to GitHub.

# Get this from console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used by the pipeline (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Get this from dashboard.stripe.com → Developers → API keys.
# Use a restricted/secret key - never the publishable key.
STRIPE_SECRET_KEY=sk_live_...

# Create a $49.99/month recurring Price in Stripe Dashboard → Product catalog,
# then paste its Price ID (starts with "price_") here.
STRIPE_PRICE_ID=price_...
