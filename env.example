# Copy this file to .env.local for local development.
# In production, set this in your Vercel project settings (Settings → Environment Variables).
# Never commit your real key to GitHub.

# Get this from console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

